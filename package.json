  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/glob": "0.7.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "private": true
}
